				<vpumlModel id="SxX60.mD.AAAAdQB" modelType="UserStoryStatus">
					<properties>
						<property name="name" type="string" value="Approved"/>
						<property name="modelType" type="string" value="UserStoryStatus"/>
						<property htmlValue="&lt;html&gt;&#10;  &lt;head&gt;&#10;    &#10;  &lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;      An &lt;b&gt;Approved&lt;/b&gt; user story is one that the product owner has reviewed and agreed to implement. It is sufficiently detailed and is a candidate to be assigned to a sprint at the sprint planning meeting.    &lt;/p&gt;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;" name="documentation" type="htmlString" value="An Approved user story is one that the product owner has reviewed and agreed to implement. It is sufficiently detailed and is a candidate to be assigned to a sprint at the sprint planning meeting."/>
						<property name="pmCreateDateTime" type="string" value="1751463741823"/>
						<property name="pmLastModified" type="string" value="1751468489556"/>
