				<vpumlModel id="yxX60.mD.AAAAdQI" modelType="UserStoryStatus">
					<properties>
						<property name="name" type="string" value="Removed"/>
						<property name="modelType" type="string" value="UserStoryStatus"/>
						<property htmlValue="&lt;html&gt;&#10;  &lt;head&gt;&#10;    &#10;  &lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;      The user story is no longer needed to be implemented. This happens when the user story is found out of scope, or when product requirements or other work conditions have changed.    &lt;/p&gt;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;" name="documentation" type="htmlString" value="The user story is no longer needed to be implemented. This happens when the user story is found out of scope, or when product requirements or other work conditions have changed."/>
