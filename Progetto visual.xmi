				<vpumlModel id="yxX60.mD.AAAAdQE" modelType="UserStoryStatus">
					<properties>
						<property name="name" type="string" value="Committed"/>
						<property name="modelType" type="string" value="UserStoryStatus"/>
						<property htmlValue="&lt;html&gt;&#10;  &lt;head&gt;&#10;    &#10;  &lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;      Committed user stories are stories that the team has committed to implement in the next sprint. User stories in the &lt;b&gt;Committed&lt;/b&gt; state must be estimated and decomposed into tasks.    &lt;/p&gt;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;" name="documentation" type="htmlString" value="Committed user stories are stories that the team has committed to implement in the next sprint. User stories in the Committed state must be estimated and decomposed into tasks."/>
						<property name="pmCreateDateTime" type="string" value="1751463741823"/>
						<property name="pmLastModified" type="string" value="1751468489556"/>
						<property name="userIDLastNumericValue" type="int" value="0"/>
