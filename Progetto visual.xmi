				<vpumlModel id="SxX60.mD.AAAAdP_" modelType="UserStoryStatus">
					<properties>
						<property name="name" type="string" value="New"/>
						<property name="modelType" type="string" value="UserStoryStatus"/>
						<property htmlValue="&lt;html&gt;&#10;  &lt;head&gt;&#10;    &#10;  &lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;      A &lt;b&gt;New&lt;/b&gt; user story is one that has been added to the product backlog and not yet been reviewed by the product owner nor agreed to build. Such a user story lacks detail the team would need to implement it. Low-priority user stories often remain in the &lt;b&gt;New&lt;/b&gt; state, while high-priority stories move quickly to the &lt;b&gt;Approved&lt;/b&gt; state.    &lt;/p&gt;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;" name="documentation" type="htmlString" value="A New user story is one that has been added to the product backlog and not yet been reviewed by the product owner nor agreed to build. Such a user story lacks detail the team would need to implement it. Low-priority user stories often remain in the New state, while high-priority stories move quickly to the Approved state."/>
						<property name="pmCreateDateTime" type="string" value="1751463741814"/>
						<property name="pmLastModified" type="string" value="1751468489556"/>
						<property name="userIDLastNumericValue" type="int" value="0"/>
