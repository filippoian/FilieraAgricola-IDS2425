{
	"name": "Java & MySQL (Docker Compose)",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspace",
	"customizations": {
		"vscode": {
			"extensions": [
				"vscjava.vscode-java-pack",
				"vmware.vscode-spring-boot",
				"vscjava.vscode-spring-boot-dashboard",
				"cweijan.vscode-mysql-manager2"
			]
		}
	},
	"forwardPorts": [
		8080,
		3306
	],
	"remoteUser": "vscode",
	"containerEnv": {
		"DB_PASSWORD": "root"
	}
}